{
  "name": "dsh-vision-no-vision",
  "version": "0.3.1",
  "description": "Gives a text-only LLM vision capability",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "src",
    "bundle"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm run build"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "tool",
    "vision",
    "ascii"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "bmp-ts": "^1.0.9",
    "omggif": "^1.0.10",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@types/node": "^24.0.0",
    "@types/omggif": "^1.0.5",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./bundle/cordis.patch.yml"
    }
  }
}
